# RouteCraft AI - Backend Environment Configuration

# OpenAI API Key (for live CrewAI agents with GPT-4 / GPT-4o)
OPENAI_API_KEY=your_openai_api_key_here

# Serper API Key (for real-time Google Search results)
# Obtain at: https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# Browserless API Key (for headless browser website scraping)
# Obtain at: https://browserless.io
BROWSERLESS_API_KEY=your_browserless_api_key_here

# Server Port
PORT=8000
HOST=0.0.0.0
